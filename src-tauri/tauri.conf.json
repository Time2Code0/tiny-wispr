{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tiny Wispr",
  "version": "0.1.0",
  "identifier": "dev.time2code.tinywispr",
  "build": {
    "beforeDevCommand": "node scripts/build-worker.mjs && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/build-worker.mjs --release && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Local, private dictation",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/tw-llm-worker"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY2QUNBMDEzNzU5MUQ1RTMKUldUajFaRjFFNkNzOWlGY2M4UkhtaDlqdWx2dXdiZndJbkV0Yk8rNTRPVHE1NmwraTk2aU1tTWkK",
      "endpoints": [
        "https://github.com/Time2Code0/tiny-wispr/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
