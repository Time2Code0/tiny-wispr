{
  "name": "tiny-wispr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "app:mac": "node scripts/app-mac.mjs",
    "build": "vite build",
    "build:worker": "node scripts/build-worker.mjs",
    "check": "ultracite check && tsc --noEmit",
    "check:rust": "node scripts/build-worker.mjs && cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "dev": "vite --port 1420 --strictPort",
    "fix": "ultracite fix",
    "preview": "vite preview --port 1420 --strictPort",
    "release": "node scripts/release.mjs",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm check && pnpm test && pnpm build && pnpm check:rust"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.2",
    "@hugeicons/react": "^1.1.10",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "motion": "^13.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "ultracite": "7.10.6",
    "vite": "^8.3.8",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.16.1"
}
